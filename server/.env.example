# Cổng chạy máy chủ backend (mặc định 5000)
PORT=5000

# Đường dẫn file cơ sở dữ liệu SQLite (tùy chọn)
# Mặc định hệ thống sẽ tự động tạo file "lms.db" ngay khi khởi chạy, không cần cài đặt gì thêm.
DATABASE_PATH=lms.db

# Bật đăng nhập nhanh tài khoản demo (CHỈ dùng khi phát triển, KHÔNG bật ở production)
# ENABLE_DEMO_LOGIN=true

# Các origin frontend được phép gọi API (phân tách bằng dấu phẩy).
# Bỏ trống -> chỉ cho phép localhost.
# CORS_ORIGIN=https://lms.example.com

# Thư mục lưu file tải lên khi không dùng R2 (mặc định ./uploads)
# UPLOADS_DIR=uploads

# Cloudflare R2 (tùy chọn)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=lms-media
# R2_PUBLIC_URL=

# Khởi tạo dữ liệu khi cơ sở dữ liệu còn trống
#  - Phát triển: mặc định nạp dữ liệu mẫu (khóa học, học viên demo...), mật khẩu 123456
#  - Production: mặc định KHÔNG có dữ liệu mẫu, chỉ tạo 1 quản trị viên từ các biến dưới đây
# SEED_DEMO_DATA=true
# SEED_ADMIN_EMAIL=admin@truong.edu.vn
# SEED_ADMIN_NAME=Quản trị viên
# SEED_DEFAULT_PASSWORD=doi-mat-khau-nay
