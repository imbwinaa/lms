{
  "name": "nep-hoc-lms",
  "version": "1.0.0",
  "description": "Nếp học - Hệ thống quản lý học tập & đào tạo (LMS) thân thiện cho ngành giáo dục",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "db:push": "pnpm --filter server db:push",
    "db:studio": "pnpm --filter server db:studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.5.0",
    "typescript": "~5.7.0"
  }
}
